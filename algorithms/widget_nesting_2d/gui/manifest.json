{
  "id": "widget_nesting_2d",
  "icon": "nest",
  "name": "2D Widget Nesting",
  "eyebrow": "IRREGULAR STOCK LAYOUT",
  "summary": "Pack varied polygons with fast envelope and raster construction, NFP repair, and genetic search; compare validated layouts and usable stock.",
  "accent": "#a17b24",
  "runtime": "local-or-tk2",
  "runtimeLabel": "TK2 default \u00b7 Mac optional",
  "capabilities": [
    "Hybrid construction",
    "NFP repair",
    "genetic search",
    "hole nesting",
    "1,000 distinct outlines",
    "SDK comparison"
  ],
  "examples": [
    {
      "id": "complex_board",
      "name": "Nest the complex dual-board case",
      "description": "Run cached polygonal NFP placement with genetic ordering and a beam of alternate layouts.",
      "target": "tk2",
      "targets": [
        "tk2",
        "local"
      ],
      "command": [
        "./geo",
        "pt",
        "-m",
        "algorithms.widget_nesting_2d.solver",
        "--input",
        "algorithms/widget_nesting_2d/inputs/complex_dual_board.json",
        "--output",
        "algorithms/widget_nesting_2d/outputs/gui_example",
        "--generations",
        "{generations}",
        "--rotation-step-degrees",
        "{rotation_step}",
        "--seed",
        "{seed}"
      ],
      "parameters": [
        {
          "id": "generations",
          "label": "Generations",
          "type": "integer",
          "default": 4,
          "min": 1,
          "max": 20,
          "step": 1
        },
        {
          "id": "rotation_step",
          "label": "Rotation step (\u00b0)",
          "type": "number",
          "default": 15,
          "min": 5,
          "max": 90,
          "step": 5
        },
        {
          "id": "seed",
          "label": "Random seed",
          "type": "integer",
          "default": 7,
          "min": 0,
          "max": 99999,
          "step": 1
        }
      ],
      "artifacts": [
        {
          "label": "Nesting layout",
          "path": "algorithms/widget_nesting_2d/outputs/gui_example/nesting_layout.png",
          "kind": "image"
        },
        {
          "label": "Solution",
          "path": "algorithms/widget_nesting_2d/outputs/gui_example/solution.json",
          "kind": "json"
        }
      ]
    }
  ],
