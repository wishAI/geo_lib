{
  "id": "widget_nesting_2d",
  "icon": "nest",
  "name": "2D Widget Nesting",
  "eyebrow": "IRREGULAR STOCK LAYOUT",
  "summary": "Pack polygons with joint order and free-angle search, adaptive raster construction and bounded NFP repair; compare validated layouts and reusable stock.",
  "accent": "#a17b24",
  "runtime": "local-or-tk2",
  "runtimeLabel": "TK2 default \u00b7 Mac optional",
  "capabilities": [
    "Free rotation",
    "Angle and order search",
    "Hybrid construction",
    "NFP repair",
    "genetic search",
    "hole nesting",
    "1,000 distinct outlines",
    "SDK comparison"
  ],
  "examples": [
    {
      "id": "complex_board",
      "name": "Nest the complex dual-board case",
      "description": "Free rotation with fast construction and adaptive polygon search, bounded by a short search budget.",
      "target": "tk2",
      "targets": [
        "tk2",
        "local"
      ],
      "command": [
        "./geo",
        "pt",
        "-m",
        "algorithms.widget_nesting_2d.gui.run",
        "--input",
        "algorithms/widget_nesting_2d/inputs/{case}.json",
        "--output",
        "algorithms/widget_nesting_2d/outputs/gui_example",
        "--generations",
        "{generations}",
        "--rotation-step-degrees",
        "{rotation_step}",
        "--seed",
        "{seed}",
        "--beam-width",
        "{beam_width}",
        "--population-size",
        "{population}",
        "--time-limit-seconds",
        "{budget}",
        "--rotation-mode",
        "{rotation_mode}",
        "--algorithms",
        "{algorithms}"
      ],
      "parameters": [
        {
          "id": "case",
          "label": "Input case",
          "type": "select",
          "default": "complex_dual_board",
          "choices": [
            "complex_dual_board",
            "constrained_single_board"
          ]
        },
        {
          "id": "algorithms",
          "label": "Algorithms",
          "type": "select",
          "default": "all",
          "choices": [
            "all",
            "nfp"
          ],
          "choiceLabels": {
            "all": "Our solver + OpenNest + Sparrow",
            "nfp": "Our solver only"
          }
        },
        {
          "id": "rotation_mode",
          "label": "Rotation",
          "type": "select",
          "choices": [
            "free",
            "discrete"
          ],
          "default": "free",
          "choiceLabels": {
            "free": "Free rotation",
            "discrete": "Fixed angle steps"
          }
        },
        {
          "id": "generations",
          "label": "Generations",
          "type": "integer",
          "default": 4,
          "min": 1,
          "max": 20,
          "step": 1
        },
        {
          "id": "rotation_step",
          "label": "Discrete angle step (\u00b0)",
          "type": "number",
          "default": 15,
          "min": 5,
          "max": 90,
          "step": 5
        },
        {
          "id": "seed",
          "label": "Random seed",
          "type": "integer",
          "default": 7,
          "min": 0,
          "max": 99999,
          "step": 1
        },
        {
          "id": "beam_width",
          "label": "Beam width",
          "type": "integer",
          "default": 4,
          "min": 1,
          "max": 12
        },
        {
          "id": "population",
          "label": "Population",
          "type": "integer",
          "default": 8,
          "min": 2,
          "max": 32
        },
        {
          "id": "budget",
          "label": "Search budget (seconds)",
          "type": "number",
          "default": 2,
          "min": 0.1,
          "max": 120
        }
      ],
      "artifacts": [
        {
          "label": "Captured input, all algorithm results & provenance",
          "path": "algorithms/widget_nesting_2d/outputs/gui_example/",
          "kind": "directory"
        }
      ],
      "uniqueOutput": true,
      "resource": "nesting",
      "commands": {
        "tk2": [
          "/home/wishai/.cache/geo-nesting-bench/venv/bin/python",
          "-m",
          "algorithms.widget_nesting_2d.gui.run",
          "--input",
          "algorithms/widget_nesting_2d/inputs/{case}.json",
          "--output",
          "algorithms/widget_nesting_2d/outputs/gui_example",
          "--generations",
          "{generations}",
          "--rotation-step-degrees",
          "{rotation_step}",
          "--seed",
          "{seed}",
          "--beam-width",
          "{beam_width}",
          "--population-size",
          "{population}",
          "--time-limit-seconds",
          "{budget}",
          "--rotation-mode",
          "{rotation_mode}",
          "--algorithms",
          "{algorithms}"
        ]
      }
    }
  ],
