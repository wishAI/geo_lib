{
  "id": "urdf_learn_wasd_walk",
  "icon": "walk",
  "name": "Learn WASD Walk",
  "eyebrow": "CLEAN TRAINING RESTART",
  "summary": "Landau locomotion is being re-certified from the first hard gate against the exact 8,864-triangle rabbit-ear mesh package shown by USD → Parallel URDF.",
  "accent": "#cb6b42",
  "runtime": "tk2-clean",
  "runtimeLabel": "TK2 · rabbit-ear asset re-certification",
  "capabilities": [
    "passive stand",
    "policy stand",
    "forward walk",
    "Isaac Lab",
    "clean room"
  ],
  "inspector": {
    "type": "evolutionTree",
    "label": "Training evolution",
    "path": "algorithms/urdf_learn_wasd_walk/outputs/evolution.json"
  },
  "examples": [
    {
      "id": "comparison_train",
      "sourceSync": "preserve-runtime",
      "name": "M2 control diagnostic · model-specific PPO smoke",
      "description": "Official G1 first; Landau is a separate diagnostic branch, never a milestone promotion. 64 envs × 2 iterations. Models and checkpoints stay on TK2.",
      "target": "tk2",
      "targets": ["tk2"],
      "resource": "isaac",
      "command": ["./geo", "walk", "compare-model", "--mode", "train", "--model", "{model}", "--num-envs", "64", "--iterations", "2", "--headless"],
      "parameters": [{
        "id": "model", "label": "Robot model / URDF asset", "type": "select",
        "choices": ["unitree_g1", "landau_current"], "default": "unitree_g1",
        "choiceLabels": {"unitree_g1": "Unitree G1 · official Isaac Lab minimal USD", "landau_current": "Landau · current rabbit-ear URDF"},
        "choiceDetails": {"unitree_g1": "Isaac-Velocity-Flat-G1-v0 · official USD dependency hash pending host asset audit; not the local MJCF-derived G1.", "landau_current": "URDF SHA 859d3c29930822f77750f6dcc0940e1c7e84393817cdefdcdc36c0025ddb46ca · mesh SHA a34be1b4f2732de526c23fd1bc53e945b9e647110432fe466521fb7e73676f73 · +Y forward"}
      }],
      "artifacts": [
        {"label": "G1 diagnostic training / asset identity", "path": "algorithms/urdf_learn_wasd_walk/outputs/model_comparison/unitree_g1/official_smoke_20260906/training.json", "kind": "json"},
        {"label": "Landau diagnostic training / asset identity", "path": "algorithms/urdf_learn_wasd_walk/outputs/model_comparison/landau_current/official_smoke_20260906/training.json", "kind": "json"}
      ]
    },
    {
      "id": "comparison_evaluate",
      "sourceSync": "preserve-runtime",
      "name": "M2 control diagnostic · checkpoint evaluation",
      "description": "Same evaluation loop; exact per-model checkpoint and asset hashes, direct bilateral contacts, 500 control steps. Diagnostic results cannot pass Landau gates.",
      "target": "tk2", "targets": ["tk2"], "resource": "isaac",
      "command": ["./geo", "walk", "compare-model", "--mode", "evaluate", "--model", "{model}", "--steps", "500", "--headless"],
      "parameters": [{"id": "model", "label": "Robot model / URDF asset", "type": "select", "choices": ["unitree_g1", "landau_current"], "default": "unitree_g1", "choiceLabels": {"unitree_g1": "Unitree G1 · official Isaac Lab minimal USD", "landau_current": "Landau · current rabbit-ear URDF"}}],
      "artifacts": [
        {"label": "G1 diagnostic evaluation / asset hash", "path": "algorithms/urdf_learn_wasd_walk/outputs/model_comparison/unitree_g1/official_smoke_20260906/evaluation.json", "kind": "json"},
        {"label": "Landau diagnostic evaluation / asset hash", "path": "algorithms/urdf_learn_wasd_walk/outputs/model_comparison/landau_current/official_smoke_20260906/evaluation.json", "kind": "json"}
      ]
    },
    {
      "id": "validate_passive_stand",
      "name": "Validate passive stand · 30 s",
      "description": "Run camera-free dynamics first, then a separate viewport proof replay; final evidence appears only when both exact components pass.",
      "target": "tk2",
      "targets": [
        "tk2"
      ],
      "resource": "isaac",
      "command": [
        "./geo",
        "walk",
        "validate-passive",
        "--headless"
      ],
      "artifacts": [
        {
          "label": "Passive stand validation",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_zero_signal_30s_no_reset/validation.json",
          "kind": "json"
        },
        {
          "label": "Camera-free dynamics evidence",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_zero_signal_30s_no_reset/dynamics_validation.json",
          "kind": "json"
        },
        {
          "label": "Viewport proof evidence",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_zero_signal_30s_no_reset/proof_validation.json",
          "kind": "json"
        },
        {
          "label": "Passive stand proof video",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_zero_signal_30s_no_reset/proof.mp4",
          "kind": "video"
        },
        {
          "label": "Start · middle · end contact sheet",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_zero_signal_30s_no_reset/contact_sheet.png",
          "kind": "image"
        }
      ]
    },
    {
      "id": "train_policy_stand",
      "name": "Train policy stand · PPO",
      "description": "Train the compact manager-based proprioceptive policy. Checkpoints stay on TK2 and Nextcloud; training never marks the gate passed.",
      "target": "tk2",
      "targets": [
        "tk2"
      ],
      "resource": "isaac",
      "command": [
        "./geo",
        "walk",
        "train-policy-stand",
        "--headless",
        "--num-envs",
        "512",
        "--iterations",
        "200"
      ],
      "artifacts": [
        {
          "label": "Policy training evidence",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/training.json",
          "kind": "json"
        }
      ]
    },
    {
      "id": "validate_policy_stand",
      "name": "Validate policy stand · 30 s",
      "description": "Evaluate the same checkpoint camera-free, then record a separate deterministic viewport proof and finalize cumulatively.",
      "target": "tk2",
      "targets": [
        "tk2"
      ],
      "resource": "isaac",
      "command": [
        "./geo",
        "walk",
        "validate-policy-stand",
        "--headless"
      ],
      "artifacts": [
        {
          "label": "Policy stand validation",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/validation.json",
          "kind": "json"
        },
        {
          "label": "Policy camera-free dynamics",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/dynamics_validation.json",
          "kind": "json"
        },
        {
          "label": "Policy viewport proof evidence",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/proof_validation.json",
          "kind": "json"
        },
        {
          "label": "Policy stand proof video",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/proof.mp4",
          "kind": "video"
        },
        {
          "label": "Policy start · middle · end contact sheet",
          "path": "algorithms/urdf_learn_wasd_walk/outputs/stand_30s_no_reset/contact_sheet.png",
          "kind": "image"
        }
      ]
    },
    {
      "id": "train_forward_walk",
      "name": "Train +Y forward walk · PPO",
      "description": "Expand the proven stand actor with semantic command inputs and fine-tune on flat standing and +Y forward commands.",
